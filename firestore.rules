rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Guestbook ──────────────────────────────────────────────────────────
    // Public read. Validated create only. No updates (messages are immutable).
    // Delete kept open because admin is managed client-side (no server auth).
    match /guestbook/{messageId} {
      allow read: if true;
      allow create: if isValidMessage();
      allow delete: if true;
      allow update: if false;
    }

    // ── Visitor counter ────────────────────────────────────────────────────
    // Single document (stats/visitors). Read/write open — no sensitive data.
    match /stats/visitors {
      allow read, write: if true;
    }

    // ── Deny everything else ───────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidMessage() {
      let d = request.resource.data;
      return d.keys().hasAll(['name', 'message', 'rating', 'timestamp'])
          && d.keys().hasOnly(['name', 'message', 'rating', 'timestamp'])
          && d.name is string
          && d.name.size() >= 1
          && d.name.size() <= 30
          && d.message is string
          && d.message.size() >= 1
          && d.message.size() <= 500
          && d.rating is int
          && d.rating >= 1
          && d.rating <= 5
          && d.timestamp is timestamp;
    }
  }
}
